# OCaml build artifacts
# Dune creates a _build directory for all its build outputs.
_build/

# OCaml generated files
# .merlin and .ocamlformat are often managed by Dune and can be regenerated.
# However, many projects do commit a .ocamlformat, so this is optional.
.merlin
.ocamlformat-ignore

# OCaml compiled files
# These are generated by the OCaml compiler.
*.cmi         # OCaml module interface files
*.cmo         # OCaml bytecode object files
*.cmx         # OCaml native code object files
*.cma         # OCaml bytecode libraries
*.cmxa        # OCaml native code libraries
*.cmxs        # OCaml native code shared libraries
*.o           # Object files (from C stubs or native compilation)
*.a           # Static libraries
*.so          # Shared libraries (from C stubs)
*.mli.fmt     # Formatted interface files
*.ml.fmt      # Formatted implementation files

# Editor/IDE specific files
# Common files from various editors.
.vscode/
.idea/
.emacs.d/
.dir-locals.el
*.swp
*~

# Generated documentation
# OCaml's documentation tool (odoc) generates documentation.
_doc/

# OCaml top-level/toplevel generated files
# Files created by the OCaml toplevel (`ocaml`).
.ocamlinit

# Opam user configuration
# These files should not be committed to a project's repository.
_opam/
opam-switch/

# Dune-specific caches and files
# These files are used by Dune internally and should not be version controlled.
.dune-project.local
.dune-project.user

# Binary executables
# These are the final executables generated by Dune.
# Add your specific executable names here if they are not in _build/.
# For example:
# my_app