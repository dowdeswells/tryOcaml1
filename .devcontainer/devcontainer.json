// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/debian
{
	"name": "Ocaml Developer Container",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
    "build": {
        "dockerfile": "Dockerfile"
    },
	"customizations": {
        "vscode": {
            "extensions": [
                "ocamllabs.ocaml-platform",
                "better-toml.better-toml"
            ],
            "settings": {
                "ocaml.project": {
                    "kind": "dune" // Or "esy" if you're using esy
                }
                // Add any other VS Code settings specific to OCaml development
            }
        }
    },
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/tryOcaml1",
    // Use 'postCreateCommand' to run commands after the container is created.
    // This is a good place to install project-specific opam dependencies.
    "postCreateCommand": "opam install --deps-only --with-test --with-doc . || true",
    // Use 'remoteUser' to run commands as a non-root user (recommended for security)
    "remoteUser": "opam" // Or 'vscode' if using specific devcontainer base images


	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
